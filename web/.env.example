# VITE_GEMINI_API_KEY: enables the "AI Advice" tactical advisor feature.
# Get a key from https://aistudio.google.com/apikey and put it here (no quotes).
# NOTE: Vite exposes VITE_ prefixed vars to client-side code, so this key is
# visible in the browser bundle. Fine for local/personal use; for a public
# deployment, proxy Gemini calls through a small backend instead.
VITE_GEMINI_API_KEY=
